
import numpy as np
import matplotlib.pyplot as plt

# Define 1000 valores de Ka entre 0,01 e 15
# Evitamos x = 0 devido à divisão por x na equação
x = np.linspace(0.01, 15, 1000)

# Define o valor de ka/pi
# j = 1 corresponde a ka = pi
j = 1

# Calcula a equação transcendental de Kronig-Penney
# P = 3 é a intensidade adimensional do potencial
for n in range(1):

    Eqtrans = np.cos(x) + 3*np.sin(x)/x - np.cos(j*np.pi)

    # Plota a função em relação a Ka
    plt.plot(x, Eqtrans, label=rf'$ka = {j}\pi$')

# Linha horizontal indicando f(Ka) = 0
# As interseções com essa linha são as raízes da equação
plt.axhline(0, color='black', linestyle='--', linewidth=1)

# Identificação dos eixos
plt.xlabel(r'$Ka$')
plt.ylabel(r'$f(Ka)$')

# Limites dos eixos (opcional)
# plt.xlim(0, 15)
# plt.ylim(-2, 4)

# Exibe a legenda
plt.legend()

# Adiciona uma grade ao gráfico
plt.grid(True, linestyle=':', alpha=0.5)

# Exibe o gráfico
plt.show()
